---
import { getCollection } from 'astro:content';
import Module from '../../components/Module.astro';
import PublicationList from '../../components/PublicationList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublications } from '../../lib/collections';
import { url } from '../../lib/url';

const journal = await getPublications('journal');
const conference = await getPublications('conference');
const theses = (await getCollection('theses')).sort((a, b) => a.data.author.localeCompare(b.data.author, 'hr'));

const sections = [
  { id: 'journal', title: 'Journal papers', count: journal.length },
  { id: 'conference', title: 'Conference papers', count: conference.length },
  { id: 'theses', title: 'Theses', count: theses.length },
] as const;

// Year is the main structure; inside each year: journal papers, conference papers, theses.
const years = [
  ...new Set([...journal, ...conference].map((p) => p.data.year).concat(theses.map((t) => t.data.year))),
].sort((a, b) => b - a);

const blocks = years.map((year) => ({
  year,
  journal: journal.filter((p) => p.data.year === year),
  conference: conference.filter((p) => p.data.year === year),
  theses: theses.filter((t) => t.data.year === year),
}));

// The first group of each type also carries the old section anchor (#journal, #conference, #theses),
// so existing links such as /publications/#theses still land on that type.
const firstYear = Object.fromEntries(
  sections.map((s) => [s.id, blocks.find((b) => b[s.id].length > 0)?.year]),
) as Record<(typeof sections)[number]['id'], number | undefined>;

// Classes used by the CSS filter to hide a year when all of its groups are unchecked.
const has = (b: (typeof blocks)[number]) =>
  ['pub-y', ...sections.filter((s) => b[s.id].length > 0).map((s) => `has-${s.id}`)].join(' ');
---

<BaseLayout title="Publications" description="Journal papers, conference papers and theses of LAMOR.">
  <div class="pubs">
    <Module title="Publications" as="h1">
      <p>
        Journal and conference papers are retrieved automatically from <a href="https://www.croris.hr/crosbi/">CROSBI</a>, the
        Croatian scientific bibliography. Names of LAMOR members are underlined.
      </p>
      <fieldset class="pub-filter">
        <legend>Show:</legend>
        {
          sections.map((s) => (
            <label>
              <input type="checkbox" id={`show-${s.id}`} checked />
              {s.title} ({s.count})
            </label>
          ))
        }
      </fieldset>
      <ul class="year-bar" aria-label="Jump to year">
        {
          blocks.map((b) => (
            <li class={has(b)}>
              <a href={`#y${b.year}`}>{b.year}</a>
            </li>
          ))
        }
      </ul>
    </Module>

    {
      blocks.map((b) => (
        <section class:list={['module', 'pub-year-block', has(b)]} id={`y${b.year}`}>
          <h2 class="module-title pub-year">{b.year}</h2>
          {b.journal.length > 0 && (
            <div class="pub-group" data-type="journal" id={firstYear.journal === b.year ? 'journal' : undefined}>
              <h3>Journal papers</h3>
              <PublicationList items={b.journal} />
            </div>
          )}
          {b.conference.length > 0 && (
            <div class="pub-group" data-type="conference" id={firstYear.conference === b.year ? 'conference' : undefined}>
              <h3>Conference papers</h3>
              <PublicationList items={b.conference} />
            </div>
          )}
          {b.theses.length > 0 && (
            <div class="pub-group" data-type="theses" id={firstYear.theses === b.year ? 'theses' : undefined}>
              <h3>Theses</h3>
              <ul class="pub-list">
                {b.theses.map(({ data }) => (
                  <li class="pub">
                    {data.author}. <span class="pub-title">{data.title}</span> // {data.type} ({data.year}).
                    {data.supervisors.length > 0 && <span class="muted"> Supervisors: {data.supervisors.join(', ')}.</span>}
                    <span class="pub-links">
                      {data.pdf && <a href={url(data.pdf)}>PDF</a>}
                      {data.url && <a href={data.url}>Link</a>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  // "Copy" buttons for the BibTeX boxes (hidden without JavaScript or clipboard access).
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.pub-bib-copy')) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const text = button.parentElement?.querySelector('pre')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Copy failed';
        }
        setTimeout(() => (button.textContent = 'Copy'), 2000);
      });
    }
  }
</script>
