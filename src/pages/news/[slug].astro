---
import type { GetStaticPaths } from 'astro';
import Module from '../../components/Module.astro';
import NewsArticle from '../../components/NewsArticle.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNews } from '../../lib/collections';
import { plainSummary } from '../../lib/markdown';
import { url } from '../../lib/url';

export const getStaticPaths = (async () =>
  (await getNews()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, image, lead } = entry.data;
---

<BaseLayout title={title} description={plainSummary(lead || entry.body)} image={image} editPath={entry.filePath}>
  <Module title="News">
    <NewsArticle entry={entry} />
    <p class="back-link"><a href={url('/news/')}>‹ All news</a></p>
  </Module>
</BaseLayout>
