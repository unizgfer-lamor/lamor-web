---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Module from '../../components/Module.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNews } from '../../lib/collections';
import { formatIsoDay } from '../../lib/dates';
import { plainSummary, renderMarkdown } from '../../lib/markdown';
import { url } from '../../lib/url';

export const getStaticPaths = (async () =>
  (await getNews()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, date, updated, author, image, imageAlt, lead, attachments } = entry.data;
const { Content } = await render(entry);
const fileName = (path: string) => decodeURIComponent(path.split('/').pop() ?? path);
---

<BaseLayout title={title} description={plainSummary(lead || entry.body)} image={image} editPath={entry.filePath}>
  <Module title="News">
    <article class="news-article">
      <div class="news-article-meta">
        <span>{author && <>Author: {author}</>}</span>
        <span>
          <time datetime={date.toISOString()}>{formatIsoDay(date)}</time>
          {updated && <> · edited {formatIsoDay(updated)}</>}
        </span>
      </div>
      <h1>{title}</h1>
      {image && <img class="news-lead-image" src={url(image)} alt={imageAlt ?? ''} />}
      <div class="prose">
        {lead && <div class="lede" set:html={renderMarkdown(lead)} />}
        <Content />
      </div>
      {
        attachments.length > 0 && (
          <div class="attachments">
            <h2 class="side-title">Attachments</h2>
            <ul>
              {attachments.map((a) => (
                <li>
                  <a href={url(a.file)}>{a.label ?? fileName(a.file)}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </article>
    <p class="back-link"><a href={url('/news/')}>‹ All news</a></p>
  </Module>
</BaseLayout>
